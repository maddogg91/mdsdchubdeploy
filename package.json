{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npx nodemon -r dotenv/config index.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "build": "cd client && npm install && npm run build"
  },
  "engines": {
    "node": "18"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.0",
    "axios": "^1.4.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.1",
    "express-session": "^1.17.3",
    "formidable": "^3.5.1",
    "googleapis": "^134.0.0",
    "lien": "^3.4.3",
    "mongodb": "^5.6.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "nodemon": "^2.0.22",
    "opn": "^6.0.0",
    "passport": "^0.6.0",
    "passport-google-oauth": "^2.0.0",
    "passport-google-oauth2": "^0.2.0",
    "passport-youtube-v3": "^2.1.0",
    "serve-favicon": "^2.5.0",
    "stripe": "^14.3.0",
    "youtube-api": "^3.0.1"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.0.0"
  },
  "private": true
}
